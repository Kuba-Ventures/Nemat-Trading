# ─────────────────────────────────────────────────────────────
# API Server (Railway)
# ─────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://user:password@host:5432/dbname
STRIPE_SECRET_KEY=sk_live_... # or sk_test_... — set the real value in Railway, not here
STRIPE_WEBHOOK_SECRET=whsec_... # set real value in Railway, not here
SHIPPO_API_TOKEN=shippo_live_... # set real value in Railway, not here
# Comma-separated frontend origins: all go into the CORS allowlist, the first is the Stripe redirect base. Include apex and www.
FRONTEND_URL=https://tommytopdecker.com,https://www.tommytopdecker.com
ADMIN_SECRET=choose-a-strong-secret-here # signs admin session tokens; rotating it signs everyone out
ADMIN_PASSWORD=choose-a-password-here # the /admin login password, checked server-side only
# ADMIN_ACCEPT_LEGACY_KEY=1 # temporary: also accept the raw ADMIN_SECRET as x-admin-key during a rollout
LABEL_LINK_SECRET=choose-another-strong-secret # signs the "Buy label" links in order emails
PORT=3000

# Google Sheets sync (Apps Script Web App)
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/<your-deployment-id>/exec
SHEETS_WEBHOOK_SECRET=<your-sheets-webhook-secret> # must match the constant in the Apps Script source

# Order emails via Resend: new-order alert to sales + confirmation to the customer. Without RESEND_API_KEY both are skipped.
RESEND_API_KEY=re_... # set real value in Railway, not here
ORDER_NOTIFY_EMAIL=sales@tommytopdecker.com # optional, this is the default
ORDER_EMAIL_FROM="Tommy Top Decker Orders <orders@tommytopdecker.com>" # optional, this is the default
SUPPORT_EMAIL=support@tommytopdecker.com # optional, reply-to on customer confirmations, this is the default

# Shippo shipping-rate calculation (optional — both have defaults)
SHIPPING_ORIGIN_ZIP=94303 # ship-from ZIP for quotes and labels
PACKED_WEIGHT_OZ=2        # first pack, packed with mailer and thank-you card
PRODUCT_WEIGHT_OZ=0.7     # each extra pack in the same order
# Optional: label return address (defaults to the business address in lib/shippo.ts)
# SHIP_FROM_NAME= SHIP_FROM_STREET1= SHIP_FROM_STREET2= SHIP_FROM_CITY= SHIP_FROM_STATE= SHIP_FROM_PHONE= SHIP_FROM_EMAIL=
SHIPPO_LABEL_FILE_TYPE=PDF_4x6 # PDF_4x6 for a label printer, PDF for letter paper

# Image uploads (optional — only needed if not using Cloudinary)
API_BASE_URL= # prefix prepended to upload URLs returned by /api/admin/upload; leave blank for relative paths

# AI / image enrichment (optional — endpoints return 503 if these are absent)
ANTHROPIC_API_KEY=sk-ant-... # used by /api/scryfall for card text enrichment
REMOVE_BG_API_KEY=...        # used by /api/scryfall for background removal on card art
# AI health checks run every 10 minutes against both keys above and email down/recovered alerts.
AI_HEALTH_ALERT_TO=finley@qsbsrollover.com # optional, team addresses only, this is the default

# Server-side Meta Purchase from the Stripe webhook (optional; no-op when unset)
# META_PIXEL_ID=891018810380986
# META_CAPI_ACCESS_TOKEN=     # Conversions API token from Events Manager > dataset Settings
# META_TEST_EVENT_CODE=       # set only while testing; routes events to Test events

# Admin Growth dashboard (optional; cards show "Connect" states when unset)
# META_ACCESS_TOKEN=          # read-only system user token with ads_read
# META_AD_ACCOUNT_ID=act_987622110989837
# GA4_SERVICE_ACCOUNT_JSON=   # service account key JSON (raw or base64), Viewer on the GA4 property
# GA4_PROPERTY_ID=541136891

# Scorecard email, every other Friday 4 PM PT from Oct 30 2026 (off until WEEKLY_SNAPSHOT_TO is set)
# WEEKLY_SNAPSHOT_TO=          # comma-separated recipients
# WEEKLY_SNAPSHOT_REPLY_TO=    # optional, where replies go
# WEEKLY_SNAPSHOT_FROM=        # optional, defaults to ORDER_EMAIL_FROM
# WEEKLY_TARGET_COST_PER_SALE_CENTS=4000

# ─────────────────────────────────────────────────────────────
# Frontend (Vercel)
# ─────────────────────────────────────────────────────────────

VITE_API_URL=https://<your-railway-service>.up.railway.app

# Cloudinary direct-upload (optional — enables browser-to-Cloudinary uploads in admin UI)
VITE_CLOUDINARY_CLOUD_NAME=     # your Cloudinary cloud name
VITE_CLOUDINARY_UPLOAD_PRESET=  # unsigned upload preset configured in Cloudinary dashboard
