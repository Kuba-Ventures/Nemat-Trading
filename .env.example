# ─────────────────────────────────────────────────────────────
# API Server (Railway)
# ─────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://user:password@host:5432/dbname
STRIPE_SECRET_KEY=sk_live_... # or sk_test_... — set the real value in Railway, not here
STRIPE_WEBHOOK_SECRET=whsec_... # set real value in Railway, not here
SHIPPO_API_TOKEN=shippo_live_... # set real value in Railway, not here
FRONTEND_URL=https://your-app.vercel.app

# Meta Conversions API (server-side Purchase event). Both must be set to enable;
# leave blank to disable server-side tracking (fail-soft, no-op).
META_PIXEL_ID=          # numeric pixel id, same value as VITE_META_PIXEL_ID
META_CAPI_ACCESS_TOKEN= # Events Manager -> Dataset -> Settings -> Conversions API -> Generate access token
META_TEST_EVENT_CODE=   # optional: Events Manager -> Test Events tab; verifies server events, remove after testing
ADMIN_SECRET=choose-a-strong-secret-here
PORT=3000

# Google Sheets sync (Apps Script Web App)
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/<your-deployment-id>/exec
SHEETS_WEBHOOK_SECRET=<your-sheets-webhook-secret> # must match the constant in the Apps Script source

# Shippo shipping-rate calculation (optional — both have defaults)
SHIPPING_ORIGIN_ZIP=94303 # ship-from ZIP code used when quoting USPS rates
PRODUCT_WEIGHT_OZ=0.7     # per-unit weight in ounces; total = qty * this

# Image uploads (optional — only needed if not using Cloudinary)
API_BASE_URL= # prefix prepended to upload URLs returned by /api/admin/upload; leave blank for relative paths

# AI / image enrichment (optional — endpoints return 503 if these are absent)
ANTHROPIC_API_KEY=sk-ant-... # used by /api/scryfall for card text enrichment
REMOVE_BG_API_KEY=...        # used by /api/scryfall for background removal on card art

# ─────────────────────────────────────────────────────────────
# Frontend (Vercel)
# ─────────────────────────────────────────────────────────────

VITE_API_URL=https://<your-railway-service>.up.railway.app
VITE_ADMIN_PASSWORD=choose-a-password-here # compiled into the browser bundle — do NOT reuse ADMIN_SECRET

# Meta (Facebook) Pixel, browser-side events. Leave blank to disable all pixel
# tracking (fail-soft, no-op). Same numeric id as META_PIXEL_ID on the server.
VITE_META_PIXEL_ID= # e.g. 1234567890123456

# Cloudinary direct-upload (optional — enables browser-to-Cloudinary uploads in admin UI)
VITE_CLOUDINARY_CLOUD_NAME=     # your Cloudinary cloud name
VITE_CLOUDINARY_UPLOAD_PRESET=  # unsigned upload preset configured in Cloudinary dashboard
